{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talk-pi",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "TalkPi", "class_name": "TalkPi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TalkPi"] }],
  // Deployment- and person-specific values are secrets, set from .deploy.vars (see README):
  // LITELLM_BASE_URL, LITELLM_KEY, BRIDGE_TOKEN, OWNER_KAKAO_IDS, AGENT_NAME, OWNER_HONORIFIC.
  "vars": {
    "MODEL_ID": "gpt-6.2-sol",
    "KIBITZER_MODEL_ID": "gpt-6-luna"
  }
}
