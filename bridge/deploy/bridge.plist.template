<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__RUN__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TALK_PI_CONFIG</key>
    <string>__CONF__</string>
  </dict>
  <key>KeepAlive</key>
  <dict>
    <key>PathState</key>
    <dict>
      <key>__CONF__/agent-messenger/kakaotalk-credentials.json</key>
      <true/>
    </dict>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/__LABEL__.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/__LABEL__.log</string>
</dict>
</plist>
